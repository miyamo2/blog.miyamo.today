# NOTE: `bun install` requires GITHUB_TOKEN to be set as an environment
# variable (GitHub Packages for the @miyamo2 scope, see .npmrc)

# blog API (blogapi.miyamo.today)
BLOG_API_MIYAMO_TODAY_URL=
BLOG_API_MIYAMO_TODAY_TOKEN=

# GitHub API (about page / avatar)
GITHUB_API_TOKEN=
# override for local development (scripts/mock-api.mjs)
# GITHUB_GRAPHQL_API_URL=http://localhost:8787/github

# Algolia
PUBLIC_ALGOLIA_APP_ID=
PUBLIC_ALGOLIA_SEARCH_KEY=
PUBLIC_ALGOLIA_INDEX_NAME=
ALGOLIA_ADMIN_KEY=
# ALGOLIA_DRY_RUN=true

# recommended articles (@miyamo2/astro-recommend-article)
# requires a running qdrant instance (see .docker/docker-compose.yaml)
OPENAI_API_KEY=
# QDRANT_URL=http://localhost:6333

# misc
FACEBOOK_APP_ID=
# ARTICLE_PER_PAGE=24
