{
  "name": "blog.miyamo.today",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "author": "miyamo2",
  "keywords": [
    "astro"
  ],
  "type": "module",
  "scripts": {
    "develop": "bunx astro dev",
    "dev": "bunx astro dev",
    "dev:status": "bunx astro dev status",
    "dev:stop": "bunx astro dev stop",
    "dev:kill": "pkill -f '[a]stro dev' ; pkill -f '[a]stro.mjs dev' ; pkill -f '[.]bin/[a]stro dev' ; exit 0",
    "start": "bunx astro preview",
    "build": "bunx astro build",
    "serve": "bunx astro preview",
    "clean": "rm -rf dist .cache",
    "typecheck": "bunx astro sync && tsc --noEmit",
    "check": "bunx astro check",
    "graphqlgen": "graphql-codegen generate",
    "e2e": "node scripts/e2e.mjs",
    "e2e:setup": "cd e2e && bun install && ./node_modules/.bin/playwright install --with-deps chromium",
    "e2e:ui": "node scripts/e2e.mjs --ui",
    "e2e:headed": "node scripts/e2e.mjs --headed",
    "e2e:debug": "node scripts/e2e.mjs --debug",
    "e2e:rerun": "node scripts/e2e.mjs --skip-build",
    "e2e:report": "cd e2e && ./node_modules/.bin/playwright show-report",
    "e2e:typecheck": "cd e2e && ./node_modules/.bin/tsc --noEmit"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.3.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@formkit/tempo": "^0.1.2",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typescript-graphql-request": "^6.4.0",
    "@miyamo2/astro-algolia-index": "https://registry.npmjs.org/@miyamo2/astro-algolia-index/-/astro-algolia-index-0.1.0.tgz",
    "@miyamo2/astro-image-placeholder": "https://registry.npmjs.org/@miyamo2/astro-image-placeholder/-/astro-image-placeholder-0.1.0.tgz",
    "@miyamo2/astro-jsonld": "https://registry.npmjs.org/@miyamo2/astro-jsonld/-/astro-jsonld-0.1.0.tgz",
    "@miyamo2/astro-loader-blogapi-miyamo-today": "^0.3.0",
    "@miyamo2/astro-recommend-article": "https://registry.npmjs.org/@miyamo2/astro-recommend-article/-/astro-recommend-article-0.1.0.tgz",
    "@starwind-ui/core": "2.0.1",
    "@tabler/icons": "^3.46.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "astro": "^7.1.6",
    "github-slugger": "^2.0.0",
    "graphql": "16.9.0",
    "graphql-request": "^6.1.0",
    "modern-css-reset": "^1.4.0",
    "p-limit": "^7.3.1",
    "prettier": "3.3.3",
    "satteri": "^0.9.5",
    "satteri-link-card": "^0.2.0",
    "schema-dts": "^2.0.0",
    "sharp": "^0.33.5",
    "subset-font": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "algoliasearch": "^5.56.0"
  }
}
