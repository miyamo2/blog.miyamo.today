---
import Layout from "../../layouts/Layout.astro";
import ArticleListPage from "../../views/ArticleListPage.astro";
import { getContent, type ArticleListPageVM } from "../../lib/content";
import { lcpThumbnail } from "../../features/ArticleList/lcp";
import { buildBreadcrumbList, buildCollectionPage } from "virtual:jsonld";
import { credits } from "../../lib/jsonld";

export async function getStaticPaths() {
  const { listPages } = await getContent();
  return listPages.map((listPage) => ({
    params: { page: `${listPage.currentPage}` },
    props: { data: listPage },
  }));
}

interface Props {
  data: ArticleListPageVM;
}

const { data } = Astro.props;

// /pages/1 was a permanent redirect to / in the Gatsby build (createRedirect)
if (data.currentPage === 1) {
  return Astro.redirect("/", 301);
}

const path = `/pages/${data.currentPage}`;
const page = path.split("/").at(-1);

const jsonLDArticleListPage = buildCollectionPage({
  ...credits,
  name: "Articles",
  path: path,
  description: page ? `記事一覧(page ${page})` : "記事一覧",
  items: data.cards.map((card) => ({ name: card.title, path: `/articles/${card.id}` })),
  // positions continue the blog's own list, which `numberOfItems` counts in full
  itemList: {
    startPosition: (data.currentPage - 1) * data.perPage + 1,
    numberOfItems: data.totalItems,
  },
});
// page 1 is "/" itself, so the trail below the root is just this page
const jsonLDBreadcrumb = buildBreadcrumbList([{ name: `page ${data.currentPage}` }]);
---

<Layout
  head={{
    path,
    title: "Articles",
    jsonLD: [jsonLDArticleListPage, jsonLDBreadcrumb],
    preloadImage: lcpThumbnail(data.cards),
  }}
>
  <ArticleListPage data={data} />
</Layout>
