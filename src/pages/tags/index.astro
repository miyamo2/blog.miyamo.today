---
import Layout from "../../layouts/Layout.astro";
import TagsPage from "../../views/TagsPage.astro";
import { getContent } from "../../lib/content";
import { buildBreadcrumbJSONLD, buildItemList, buildJSONLD } from "../../../integrations/jsonld/builder";

const { tagSummaries } = await getContent();

const path = "/tags";

const jsonLDTagsPage = buildJSONLD({
  type: "CollectionPage",
  name: "Tags",
  path: path,
  description: "タグ一覧",
  withUrl: true,
  withAuthor: true,
  withPublisher: true,
  withContext: true,
  withID: true,
  attributes: {
    mainEntity: buildItemList(
      tagSummaries.map((tag) => ({ name: `#${tag.name}`, path: `/tags/${tag.cursor}` }))
    ),
  },
});
const jsonLDBreadcrumb = buildBreadcrumbJSONLD([{ name: "Tags", path }]);
---

<Layout head={{ path, title: "Tags", jsonLD: [jsonLDTagsPage, jsonLDBreadcrumb] }}>
  <TagsPage data={tagSummaries} />
</Layout>
