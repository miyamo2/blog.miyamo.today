---
import Layout from "../../../layouts/Layout.astro";
import TaggedArticlesPage from "../../../views/TaggedArticlesPage.astro";
import { getContent, type TaggedArticlesPageVM } from "../../../lib/content";
import { buildBreadcrumbJSONLD, buildItemList, buildJSONLD } from "../../../../integrations/jsonld/builder";

export async function getStaticPaths() {
  const { taggedPages } = await getContent();
  return taggedPages.map((taggedPage) => ({
    params: { tag: taggedPage.tagId, page: `${taggedPage.currentPage}` },
    props: { data: taggedPage },
  }));
}

interface Props {
  data: TaggedArticlesPageVM;
}

const { data } = Astro.props;

// /tags/{tagId}/1 was a permanent redirect to /tags/{tagId} in the Gatsby build
if (data.currentPage === 1) {
  return Astro.redirect(`/tags/${data.tagId}`, 301);
}

const title = `#${data.tagName}`;
const path = `/tags/${data.tagId}/${data.currentPage}`;
const page = path.split("/").at(-1);

const jsonLDTaggedArticlesPage = buildJSONLD({
  type: "CollectionPage",
  name: title,
  path: path,
  description: page ? `#${data.tagName}の記事一覧(page ${page})` : `#${data.tagName}の記事一覧`,
  withUrl: true,
  withAuthor: true,
  withPublisher: true,
  withContext: true,
  withIsPartOf: true,
  withID: true,
  attributes: {
    mainEntity: buildItemList(
      data.cards.map((card) => ({ name: card.title, path: `/articles/${card.id}` }))
    ),
  },
});
const jsonLDBreadcrumb = buildBreadcrumbJSONLD([
  { name: "Tags", path: "/tags" },
  { name: title, path: `/tags/${data.tagId}` },
  { name: `page ${data.currentPage}`, path },
]);
---

<Layout head={{ path, title, jsonLD: [jsonLDTaggedArticlesPage, jsonLDBreadcrumb] }}>
  <TaggedArticlesPage data={data} />
</Layout>
