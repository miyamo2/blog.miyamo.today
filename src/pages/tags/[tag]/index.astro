---
import Layout from "../../../layouts/Layout.astro";
import TaggedArticlesPage from "../../../views/TaggedArticlesPage.astro";
import { getContent, type TaggedArticlesPageVM } from "../../../lib/content";
import { buildBreadcrumbList, buildCollectionPage } from "virtual:jsonld";

export async function getStaticPaths() {
  const { taggedPages } = await getContent();
  return taggedPages
    .filter((taggedPage) => taggedPage.currentPage === 1)
    .map((taggedPage) => ({
      params: { tag: taggedPage.tagId },
      props: { data: taggedPage },
    }));
}

interface Props {
  data: TaggedArticlesPageVM;
}

const { data } = Astro.props;

const title = `#${data.tagName}`;
const path = `/tags/${data.tagId}`;

const jsonLDTaggedArticlesPage = buildCollectionPage({
  name: title,
  path: path,
  description: `#${data.tagName}の記事一覧`,
  author: true,
  publisher: true,
  items: data.cards.map((card) => ({ name: card.title, path: `/articles/${card.id}` })),
});
const jsonLDBreadcrumb = buildBreadcrumbList([
  { name: "Tags", path: "/tags" },
  { name: title, path },
]);
---

<Layout head={{ path, title, jsonLD: [jsonLDTaggedArticlesPage, jsonLDBreadcrumb] }}>
  <TaggedArticlesPage data={data} />
</Layout>
