---
import Layout from "../layouts/Layout.astro";
import ArticleListPage from "../views/ArticleListPage.astro";
import { getContent } from "../lib/content";
import { lcpThumbnail } from "../features/ArticleList/lcp";
import { buildCollectionPage } from "virtual:jsonld";
import { credits } from "../lib/jsonld";
import { PER_PAGE } from "../lib/site";

const { listPages } = await getContent();
const data = listPages.at(0) ?? {
  currentPage: 1,
  perPage: PER_PAGE,
  totalItems: 0,
  cards: [],
};

const path = "/";
const page = path.split("/").at(-1);

// A CollectionPage carrying an ItemList: the page is a page, and `name` /
// `description` / `author` are defined there. It is also the Blog itself --
// /pages/2 and the tag pages are slices of the same list.
const jsonLDArticleListPage = buildCollectionPage({
  ...credits,
  type: ["CollectionPage", "Blog"],
  name: "Articles",
  path: path,
  description: page ? `記事一覧(page ${page})` : "記事一覧",
  items: data.cards.map((card) => ({ name: card.title, path: `/articles/${card.id}` })),
  // the list runs past this page, so `numberOfItems` counts every article
  itemList: { numberOfItems: data.totalItems },
});
---

<Layout
  head={{
    path,
    title: "Articles",
    jsonLD: [jsonLDArticleListPage],
    preloadImage: lcpThumbnail(data.cards),
  }}
>
  <ArticleListPage data={data} />
</Layout>
