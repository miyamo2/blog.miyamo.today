---
import Layout from "../layouts/Layout.astro";
import ArticleListPage from "../views/ArticleListPage.astro";
import { getContent } from "../lib/content";
import { buildCollectionPage } from "virtual:jsonld";
import { PER_PAGE } from "../lib/site";

const { listPages } = await getContent();
const data = listPages.at(0) ?? {
  currentPage: 1,
  perPage: PER_PAGE,
  totalItems: 0,
  cards: [],
};

const path = "/";
const page = path.split("/").at(-1);

// CollectionPage over an ItemList rather than a bare ItemList: the page is a
// page, and `name` / `description` / `author` are only defined on the former.
const jsonLDArticleListPage = buildCollectionPage({
  name: "Articles",
  path: path,
  description: page ? `記事一覧(page ${page})` : "記事一覧",
  author: true,
  publisher: true,
  items: data.cards.map((card) => ({ name: card.title, path: `/articles/${card.id}` })),
});
---

<Layout head={{ path, title: "Articles", jsonLD: [jsonLDArticleListPage] }}>
  <ArticleListPage data={data} />
</Layout>
