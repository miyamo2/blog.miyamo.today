---
import Layout from "../../layouts/Layout.astro";
import ArticleDetailPage from "../../views/ArticleDetailPage.astro";
import { getContent, type ArticleDetailVM } from "../../lib/content";
import { buildBreadcrumbJSONLD, buildJSONLD } from "../../../integrations/jsonld/builder";
import { siteMetadata } from "../../lib/site";

export async function getStaticPaths() {
  const { details } = await getContent();
  return details.map((detail) => ({
    params: { id: detail.id },
    props: { data: detail },
  }));
}

interface Props {
  data: ArticleDetailVM;
}

const { data } = Astro.props;

const path = `/articles/${data.id}`;
const url = `${siteMetadata.siteUrl}${path}`;

const jsonLDArticleDetailPage = buildJSONLD({
  type: "BlogPosting",
  headline: data.title ?? "",
  path: path,
  description: data.excerpt ?? "",
  image: data.imageSrc,
  withMainEntityOfPage: true,
  withAuthor: true,
  withPublisher: true,
  withContext: true,
  withIsPartOf: true,
  withID: true,
  attributes: {
    datePublished: data.createdAt,
    dateModified: data.updatedAt,
    // no `articleBody`: it held the same 140-character excerpt as
    // `description`, which claims the article body *is* those 140 characters
    // to anything that reads the property at face value. Dropping it says
    // nothing rather than something false; google ignores it either way.
    keywords: data.tags.map((tag) => tag.name).join(" "),
  },
});
// articles hang straight off the root: the article list is "/" itself
const jsonLDBreadcrumb = buildBreadcrumbJSONLD([{ name: data.title, path }]);
---

<Layout
  head={{
    path,
    title: data.title,
    description: data.excerpt,
    image: data.imageSrc,
    jsonLD: [jsonLDArticleDetailPage, jsonLDBreadcrumb],
  }}
>
  <ArticleDetailPage data={data} url={url} />
</Layout>
