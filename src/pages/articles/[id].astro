---
import Layout from "../../layouts/Layout.astro";
import ArticleDetailPage from "../../views/ArticleDetailPage.astro";
import { getContent, type ArticleDetailVM } from "../../lib/content";
import { buildArticle, buildBreadcrumbList } from "virtual:jsonld";
import { credits } from "../../lib/jsonld";
import { siteMetadata } from "../../lib/site";

export async function getStaticPaths() {
  const { details } = await getContent();
  return details.map((detail) => ({
    params: { id: detail.id },
    props: { data: detail },
  }));
}

interface Props {
  data: ArticleDetailVM;
}

const { data } = Astro.props;

const path = `/articles/${data.id}`;
const url = `${siteMetadata.siteUrl}${path}`;

// buildArticle fills in the `isPartOf` link to the WebSite and the
// `mainEntityOfPage` from the integration's config. Its `@id` ends in #article:
// the article and the page it sits on are two things, and `mainEntityOfPage`
// already claims the page's own url.
const jsonLDArticleDetailPage = buildArticle({
  ...credits,
  headline: data.title ?? "",
  path: path,
  description: data.excerpt ?? "",
  image: data.imageSrc,
  datePublished: data.createdAt,
  dateModified: data.updatedAt,
  keywords: data.tags.map((tag) => tag.name),
});
// articles hang straight off the root: the article list is "/" itself
const jsonLDBreadcrumb = buildBreadcrumbList([{ name: data.title }]);
---

<Layout
  head={{
    path,
    title: data.title,
    description: data.excerpt,
    image: data.imageSrc,
    jsonLD: [jsonLDArticleDetailPage, jsonLDBreadcrumb],
  }}
>
  <ArticleDetailPage data={data} url={url} />
</Layout>
