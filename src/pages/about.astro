---
import Layout from "../layouts/Layout.astro";
import AboutPage, { type AboutVM } from "../views/AboutPage.astro";
import { fetchGitHubProfile } from "../lib/api";
import { buildRemoteImage } from "../lib/images";
import { buildBreadcrumbList, buildProfilePage, config } from "virtual:jsonld";
import { credits } from "../lib/jsonld";

const profile = await fetchGitHubProfile();
const avatarImage = await buildRemoteImage(profile.avatarUrl, { width: 350, height: 350 });

const data: AboutVM = {
  login: profile.login,
  url: profile.url,
  bio: profile.bio,
  socialAccounts: profile.socialAccounts,
  avatarImage,
};

const path = "/about";
// The page is *about* miyamo2, which is what ProfilePage exists to say and what
// google's ProfilePage structured data requires. `mainEntity` is the configured
// author plus the two things only this page knows -- the GitHub avatar and bio.
// It carries the same `@id` as the Person <JsonLd /> emits site-wide, so the
// extra terms belong to that one entity.
const jsonLDAboutPage = buildProfilePage({
  ...credits,
  person: {
    ...config.author,
    name: config.author?.name ?? profile.login,
    image: profile.avatarUrl,
    ...(profile.bio ? { description: profile.bio } : {}),
  },
  name: "About",
  path: path,
  description: "miyamo2について",
});
const jsonLDBreadcrumb = buildBreadcrumbList([{ name: "About" }]);
---

<Layout
  head={{
    path,
    title: "About",
    jsonLD: [jsonLDAboutPage, jsonLDBreadcrumb],
    preloadImage: avatarImage,
  }}
>
  <AboutPage data={data} />
</Layout>
