---
import Layout from "../layouts/Layout.astro";
import AboutPage, { type AboutVM } from "../views/AboutPage.astro";
import { fetchGitHubProfile } from "../lib/api";
import { buildRemoteImage } from "../lib/images";
import { buildBreadcrumbJSONLD, buildJSONLD } from "../../integrations/jsonld/builder";

const profile = await fetchGitHubProfile();
const avatarImage = await buildRemoteImage(profile.avatarUrl, { width: 350, height: 350 });

const data: AboutVM = {
  login: profile.login,
  url: profile.url,
  bio: profile.bio,
  socialAccounts: profile.socialAccounts,
  avatarImage,
};

const path = "/about";
const jsonLDAboutPage = buildJSONLD({
  type: "ProfilePage",
  name: "About",
  path: path,
  description: "miyamo2について",
  // a ProfilePage is already a WebPage, so mainEntityOfPage would only point
  // the node back at itself; `@id` + `url` say the same thing without it
  withUrl: true,
  withAuthor: true,
  withPublisher: true,
  withContext: true,
  withID: true,
});
const jsonLDBreadcrumb = buildBreadcrumbJSONLD([{ name: "About", path }]);
---

<Layout head={{ path, title: "About", jsonLD: [jsonLDAboutPage, jsonLDBreadcrumb] }}>
  <AboutPage data={data} />
</Layout>
