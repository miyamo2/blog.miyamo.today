---
import { ClientRouter } from "astro:transitions";
import BaseHead, { type Props as BaseHeadProps } from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// keep the same css load order as the previous React island (views/App.tsx)
import "modern-css-reset";
import "prism-themes/themes/prism-dracula.css";
import "../styles/starwind.css";
import "../styles/global.css";
import "../styles/vendor.css";

export interface Props {
  head?: BaseHeadProps;
}

const { head = {} } = Astro.props;

// starwind theme init (replaces @yamada-ui/core's getColorModeScript);
// runs before paint so the initial render already has the right color mode
const themeInitScript = `(function () {
  function initTheme() {
    var colorTheme = localStorage.getItem("colorTheme");
    var prefersDark =
      window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
    if (!colorTheme || colorTheme === "system") {
      document.documentElement.classList.toggle("dark", prefersDark);
    } else {
      document.documentElement.classList.toggle("dark", colorTheme === "dark");
    }
  }
  initTheme();
  document.addEventListener("astro:after-swap", initTheme);
})();`;

// click handler for the code block copy button (src/lib/rehype-code-block.ts)
const copyToClipboardScript = `window.copyCodeToClipboard = async (button, codeContainer) => {
  if (button.textContent === "Copied") {
    return;
  }
  navigator.clipboard.writeText(codeContainer.textContent || "");
  button.classList.add("copied");
  button.textContent = "Copied!";
  await new Promise((resolve) => {
    setTimeout(() => {
      button.classList.remove("copied");
      button.textContent = "Copy";
      resolve("done");
    }, 1500);
  });
};`;

// the Buy Me a Coffee widget injects #bmc-wbtn / #bmc-iframe into <body> at
// runtime; carry them over to the next document so the ClientRouter swap
// doesn't drop them (the widget script itself only ever runs once)
const bmcPersistScript = `document.addEventListener("astro:before-swap", (event) => {
  document.querySelectorAll("#bmc-wbtn, #bmc-iframe").forEach((el) => {
    event.newDocument.body.appendChild(el);
  });
});`;
---

<!doctype html>
<html lang="ja">
  <head>
    <script is:inline set:html={themeInitScript} />
    <BaseHead {...head} />
    <ClientRouter />
    <script is:inline set:html={copyToClipboardScript} />
    <script is:inline set:html={bmcPersistScript} />
  </head>
  <body>
    <div id="app-root">
      <div id="app-focus-wrapper">
        <div id="layout" class="bg-background h-fit min-h-screen w-full">
          <div
            class="header-wrapper scrollbar-offset bg-header flex h-[70px]"
            transition:persist="site-header"
          >
            <div class="flex w-full justify-center">
              <div class="mx-4 w-full max-w-[1400px] lg:mx-0 lg:w-[95vw]">
                <Header />
              </div>
            </div>
          </div>
          <div id="content" class="flex h-fit min-h-screen self-start">
            <div class="scrollbar-offset flex w-full flex-col justify-between">
              <div class="flex w-full justify-center">
                <div class="mx-5 w-full max-w-[1400px] lg:mx-0 lg:w-[95vw]">
                  <slot />
                </div>
              </div>
              <div class="w-full self-end">
                <Footer />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    {/* Buy Me a Coffee widget (gatsby-ssr.tsx setPostBodyComponents) */}
    <script
      is:inline
      data-name="BMC-Widget"
      src="https://cdnjs.buymeacoffee.com/1.0.0/widget.prod.min.js"
      data-id="miyamo2"
      data-description="Support me on Buy me a coffee!"
      data-message=""
      data-color="#186BF2"
      data-position="Right"
      data-x_margin="18"
      data-y_margin="18"></script>
  </body>
</html>
