---
import { faSearch, faXmark } from "@fortawesome/free-solid-svg-icons";
import { Dialog, DialogContent, DialogHeader, DialogTitle, DialogTrigger } from "../starwind/dialog";
import { Input } from "../starwind/input";
import FaIcon from "../FaIcon.astro";
import "./Search.css";

/**
 * Algolia search, previously react-instantsearch inside a Yamada UI modal.
 * The markup is static; `./search.ts` wires the querying and result rendering
 * and is fetched on demand (see the bootstrap script at the bottom).
 * This component is rendered twice by Header.astro (mobile / desktop), so every
 * hook below is scoped to the `.algolia-search` wrapper instead of an id.
 */
---

<Dialog class="algolia-search">
  <DialogTrigger
    aria-label="search"
    class="bg-background border-border hover:bg-muted focus-visible:ring-outline/50 inline-flex h-9 w-16 items-center justify-center rounded-3xl border text-sm font-bold transition-all outline-none focus-visible:ring-3 lg:text-base"
  >
    <FaIcon icon={faSearch} />
  </DialogTrigger>

  {/* no display utility here: it would override the closed <dialog>'s ua display:none */}
  {/* mobile-first: fills the screen below lg, then lg: restores the centered card */}
  <DialogContent
    class="search-dialog top-0 left-0 h-dvh max-h-none w-full max-w-none translate-x-0 translate-y-0 sm:top-0 sm:translate-y-0 rounded-none border-0 overflow-hidden p-4 lg:top-[10vh] lg:left-[50%] lg:h-auto lg:max-h-[80vh] lg:w-[92vw] lg:max-w-3xl lg:translate-x-[-50%] lg:rounded-lg lg:border"
    animationDuration={300}
  >
    <DialogHeader class="sr-only">
      <DialogTitle>Search articles</DialogTitle>
    </DialogHeader>

    <div class="flex h-full min-h-0 flex-col gap-3">
      <div class="relative pr-9">
        <FaIcon
          icon={faSearch}
          class="text-muted-foreground pointer-events-none absolute top-1/2 left-3 -translate-y-1/2"
        />
        <Input
          type="text"
          data-search-input
          class="bg-background dark:bg-background rounded-3xl pr-10 pl-9"
          placeholder="search articles with algolia"
          aria-label="search articles"
          autocomplete="off"
          autocapitalize="off"
          spellcheck={false}
        />
        <button
          type="button"
          data-search-clear
          aria-label="clear search"
          hidden
          class="text-muted-foreground hover:text-foreground focus-visible:ring-outline/50 absolute top-1/2 right-3 -translate-y-1/2 rounded-full p-1 transition-colors outline-none focus-visible:ring-3"
        >
          <FaIcon icon={faXmark} />
        </button>
      </div>

      <div data-search-results hidden class="scrollable-y flex min-h-0 flex-1 flex-col gap-2 overflow-y-auto">
        <p data-search-count class="text-muted-foreground text-right text-sm" hidden></p>
        <p data-search-status class="text-muted-foreground py-6 text-center text-sm" hidden></p>
        <div data-search-hits class="flex flex-col gap-2"></div>
        <nav data-search-pager class="search-pager" aria-label="search result pages" hidden></nav>
        <a
          class="ais-PoweredBy"
          href="https://www.algolia.com"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Search by Algolia"
        >
          <svg viewBox="0 0 572 64" height="1.2em" aria-hidden="true">
