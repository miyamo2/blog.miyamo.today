const shown = targets.filter((target) => stackType === "v" || !target.verticalOnly);

// "h" relies on the parent for layout, so the links have to stay direct flex items
const stackClass = stackType === "v" ? "mx-auto flex w-fit flex-col gap-2" : "contents";
---

<div class={stackClass}>
  {
    shown.map((target) => (
      <a
        href={target.href}
        aria-label={
          target.href.startsWith("mailto:") ? "Share by Email" : `Share on ${target.label}`
        }
        class="w-fit"
        target={target.href.startsWith("mailto:") ? undefined : "_blank"}
        rel={target.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
      >
        <svg
          viewBox="0 0 64 64"
          width={buttonSize}
          height={buttonSize}
          aria-hidden="true"
          focusable="false"
        >
          <circle cx="32" cy="32" r="32" fill={target.color} />
          <path d={target.glyph} fill="white" />
        </svg>
      </a>
    ))
  }
</div>
