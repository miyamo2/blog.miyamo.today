---
/**
 * Share links for an article.
 * Replaces react-share: plain share-intent anchors rendered with the same round
 * brand icons (glyph path data carried over from react-share's icon set).
 */
type StackType = "v" | "h";

interface Props {
  title: string;
  url: string;
  stackType: StackType;
  buttonSize: number;
}

const { title, url, stackType, buttonSize } = Astro.props;

const encodedURL = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

interface ShareTarget {
  /** used for the aria-label: "Share on {label}" */
  label: string;
  href: string;
  /** brand color of the round background */
  color: string;
  glyph: string;
  /** email was only offered on the vertical stack */
  verticalOnly?: boolean;
}

