---
// generates the same client-side redirect page as gatsby-plugin-client-side-redirect
export interface Props {
  to: string;
}
const { to } = Astro.props;
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to {to}</title>
    <meta http-equiv="refresh" content={`0; URL='${to}'`} />
    <link rel="canonical" href={to} />
  </head>
  <body></body>
</html>
