{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "allowJs": true,
    "types": ["astro/client"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "integrations/**/*", "astro.config.ts"],
  "exclude": ["dist", "node_modules", ".cache"]
}
